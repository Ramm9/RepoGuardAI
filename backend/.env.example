# RepoGuard backend - environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# NAMES AND SHAPES ONLY. There are no values in this file, and no
# plausible-looking placeholders either: a placeholder that looks like a real
# credential eventually gets treated as one. Where a value can be generated, the
# command to generate it is given instead.
#
# Settings read these with NO DEFAULT in production (config/settings/production.py).
# A missing secret crashes the process at import rather than starting a service
# with a security control silently disabled. See docs/security.md §2.

# ---------------------------------------------------------------------------
# Django - required
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
# Comma-separated. Required in production; must not contain "*".
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database - required
# ---------------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:5432/DBNAME
# Omit entirely in local development to fall back to SQLite at backend/db.sqlite3.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis / Celery - required in production, optional locally
# ---------------------------------------------------------------------------
# Separate databases: cache/throttles, broker, results. Sharing one makes a
# `FLUSHDB` during debugging drop in-flight analysis jobs.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------------------
# GitHub App - required
# ---------------------------------------------------------------------------
# From the App's settings page: https://github.com/settings/apps/<slug>
# Permissions requested are read-only (docs/github-integration.md §2).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The private key. Supply exactly one of these two.
#
#   GITHUB_APP_PRIVATE_KEY_PATH  preferred - path to a mounted PEM file.
#   GITHUB_APP_PRIVATE_KEY       the PEM itself, \n-escaped or base64.
#
# The file mount is preferred in production because an environment variable is
# visible in `docker inspect`, in process listings, and in crash dumps.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=

# Must match the App's webhook secret byte-for-byte. Signature verification has
# no development bypass - a wrong value means every webhook is rejected, which is
# the correct failure mode. docs/webhook-flow.md §3.
GITHUB_WEBHOOK_SECRET=

# Fernet key for encrypting installation tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates every stored token; users reconnect.
GITHUB_TOKEN_ENCRYPTION_KEY=

# GitHub Enterprise only. Defaults to https://api.github.com
GITHUB_API_BASE_URL=

# ---------------------------------------------------------------------------
# Frontend / CORS - required
# ---------------------------------------------------------------------------
# Explicit origins only. A wildcard is never valid here: credentials are sent
# with every request, and a browser rejects wildcard-plus-credentials anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transport security - production only, all have safe defaults
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# "Lax" is correct for a same-site deployment. A frontend on a different
# registrable domain needs "None", and that invalidates the CSRF trade-off in
# common/authentication.py - read docs/security.md §4 before changing it.
SESSION_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Analysis tuning - optional, defaults shown
# ---------------------------------------------------------------------------
# Each of these has a visible product consequence when it bites, and each is
# reported in the analysis job's stage detail rather than applied silently.
# docs/analysis-pipeline.md §4.3.
HISTORY_DEPTH_DAYS=90
MAX_INITIAL_COMMITS=1000
PUSH_COMMIT_LIMIT=20
DIFF_RETENTION_DAYS=30
LABEL_MATURITY_DAYS=90
JOB_TIMEOUT_MINUTES=60
MAX_FILE_BYTES=1048576
MAX_FILES_PER_COMMIT=300
MAX_WEBHOOK_BODY_BYTES=5242880
MODEL_ARTIFACT_DIR=

# ---------------------------------------------------------------------------
# Logging - optional
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# "plain" locally, "json" in production (production.py forces json regardless).
LOG_FORMAT=plain
