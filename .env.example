# ---------------------------------------------------------------------------
# RepoGuard frontend environment
# Copy to `.env.local` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the Django REST Framework backend.
# All GitHub access tokens and analysis jobs live server-side; the browser
# never receives a GitHub credential.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Serve the UI from the typed mock fixtures in `services/mock/` instead of
# calling the backend. Set to `false` once Django is running.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Simulated latency (ms) applied to mock responses so loading and skeleton
# states are exercised during development.
NEXT_PUBLIC_MOCK_LATENCY=450
